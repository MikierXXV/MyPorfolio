---
import { constellationGeometry, toolsCopy } from '../data/tools';
const geoJSON  = JSON.stringify(constellationGeometry);
const copyJSON = JSON.stringify(toolsCopy);
---

<section class="tools" id="tools">
  <div class="section-head">
    <h2 class="section-title" data-i18n="tools_title">AI &amp; <em>Tools</em></h2>
    <span class="section-aside" data-i18n="tools_aside">Hover a constellation</span>
  </div>

  <div class="tools-body">
    <div class="sky-wrap">
      <div class="sky-stage" id="sky-stage">
        <!-- background stars injected by JS -->
        <svg class="sky-svg" id="sky-svg" aria-hidden="true"></svg>
        <!-- constellation nodes injected by JS -->
      </div>
    </div>

    <div class="tools-panel" id="tools-panel">
      <div class="panel-empty" id="panel-empty">
        <p class="panel-hint" data-i18n="tools_hint">hover · discover · imagine</p>
      </div>
      <div class="panel-detail hidden" id="panel-detail">
        <p class="detail-cat"  id="d-cat"></p>
        <h3 class="detail-name" id="d-name"></h3>
        <p class="detail-usage-wrap"><span class="detail-usage-lbl">freq · </span><span class="detail-usage" id="d-usage"></span></p>
        <p class="detail-text" id="d-text"></p>
        <div class="detail-tags" id="d-tags"></div>
      </div>
    </div>
  </div>

  <p class="tools-footnote" data-i18n="tools_footnote">
    Models change every season. The craft of working with them — what to ask, when to trust, when to ignore — is the real stack now.
  </p>
</section>

<style is:global>
  .tools {
    padding: 6rem var(--pad) 4rem;
    max-width: var(--max); margin: 0 auto;
  }
  .section-head {
    display: flex; justify-content: space-between; align-items: baseline;
    border-top: 1px solid var(--rule); padding-top: 0.85rem; margin-bottom: 3rem;
  }
  .section-title {
    font-family: var(--serif); font-weight: 300;
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.02em; line-height: 1.1; color: var(--ink);
  }
  .section-title em { font-style: italic; font-weight: 400; }
  .section-aside {
    font-family: var(--mono); font-size: 0.68rem;
    text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-mute);
  }

  .tools-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 780px) {
    .tools-body { grid-template-columns: 2fr 1fr; align-items: start; }
  }

  /* ── Sky stage ── */
  .sky-wrap { position: relative; }
  .sky-stage {
    position: relative; width: 100%;
    height: 65vh; min-height: 360px; max-height: 620px;
    background: #0D0C0A;
    border-radius: 8px; overflow: hidden;
  }
  .sky-svg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    pointer-events: none; overflow: visible;
  }

  /* background twinkle stars */
  .bg-star {
    position: absolute; border-radius: 50%;
    background: rgba(255,255,255,0.55);
    animation: twinkle var(--dur, 3s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
  @keyframes twinkle {
    0%,100% { opacity: 0.2; transform: scale(1); }
    50%      { opacity: 0.9; transform: scale(1.4); }
  }

  /* constellation star dots */
  .c-star {
    position: absolute; border-radius: 50%;
    transform: translate(-50%, -50%);
    background: rgba(255,255,255,0.7);
    transition: background .3s, box-shadow .3s, opacity .3s;
    pointer-events: none;
    animation: breathe var(--bdur, 4s) ease-in-out infinite;
    animation-delay: var(--bdelay, 0s);
  }
  .c-star.s-lg { width: 6px; height: 6px; }
  .c-star.s-md { width: 4px; height: 4px; }
  .c-star.s-sm { width: 2.5px; height: 2.5px; }
  @keyframes breathe {
    0%,100% { opacity: 0.5; }
    50%      { opacity: 1; }
  }
  .c-star.lit { background: #fff; box-shadow: 0 0 8px 2px rgba(255,255,255,.7); }
  .c-star.dim { opacity: 0.1; }

  /* constellation lines */
  .c-line {
    stroke: rgba(255,255,255,0.2); stroke-width: 1;
    transition: stroke .3s, opacity .3s;
  }
  .c-line.lit { stroke: rgba(255,255,255,0.65); }
  .c-line.dim { opacity: 0.05; }

  /* constellation label */
  .c-label {
    position: absolute; transform: translate(-50%, calc(-50% + 52px));
    font-family: var(--mono); font-size: 0.58rem;
    text-transform: uppercase; letter-spacing: 0.14em;
    color: rgba(255,255,255,0.35);
    pointer-events: none;
    transition: color .3s, opacity .3s;
    white-space: nowrap;
  }
  .c-label.lit { color: rgba(255,255,255,0.85); }
  .c-label.dim { opacity: 0.1; }

  /* constellation hit area */
  .c-hit {
    position: absolute; transform: translate(-50%, -50%);
    width: 90px; height: 90px; border-radius: 50%;
    cursor: pointer; z-index: 5;
    background: transparent;
  }

  /* ── Side panel ── */
  .tools-panel {
    background: var(--paper-2); border: 1px solid var(--rule);
    border-radius: 8px; padding: 1.75rem;
    min-height: 220px; display: flex; align-items: flex-start;
  }
  .panel-empty, .panel-detail { width: 100%; }
  .panel-hint {
    font-family: var(--mono); font-size: 0.65rem;
    text-transform: uppercase; letter-spacing: 0.15em;
    color: var(--ink-mute); font-style: italic;
  }
  .hidden { display: none; }

  .detail-cat {
    font-family: var(--mono); font-size: 0.6rem;
    text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-mute);
    margin-bottom: 0.3rem;
  }
  .detail-name {
    font-family: var(--serif); font-weight: 300;
    font-size: clamp(1.25rem, 2vw, 1.6rem); color: var(--ink);
    line-height: 1.2; margin-bottom: 0.5rem;
  }
  .detail-name em { font-style: italic; font-weight: 400; }
  .detail-usage-wrap {
    font-family: var(--mono); font-size: 0.6rem;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--ink-mute); margin-bottom: 0.85rem;
  }
  .detail-usage-lbl { color: var(--ink-mute); }
  .detail-usage { color: var(--ink); }
  .detail-text {
    font-family: var(--sans); font-size: 0.82rem; color: var(--ink-soft);
    line-height: 1.7; margin-bottom: 0.85rem;
  }
  .detail-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .detail-tag {
    font-family: var(--mono); font-size: 0.58rem;
    text-transform: uppercase; letter-spacing: 0.1em;
    padding: 0.2rem 0.55rem; border: 1px solid var(--rule);
    border-radius: 100px; color: var(--ink-mute);
  }

  .tools-footnote {
    font-family: var(--mono); font-size: 0.62rem;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-mute);
    margin-top: 1.25rem; text-align: center; line-height: 1.8;
  }
</style>

<script define:vars={{ geoJSON, copyJSON }}>
  const geo  = JSON.parse(geoJSON);
  const copy = JSON.parse(copyJSON);

  let currentLang = 'en';
  let activeId = null;

  const stage    = document.getElementById('sky-stage');
  const skySvg   = document.getElementById('sky-svg');
  const panelEmpty  = document.getElementById('panel-empty');
  const panelDetail = document.getElementById('panel-detail');

  const starsMap  = {};  // id -> [el, ...]
  const linesMap  = {};  // id -> [el, ...]
  const labelsMap = {};  // id -> el
  const hitMap    = {};  // id -> el

  const CONST_SIZE = 90;   // local star coords map to this px box

  /* ─── BACKGROUND STARS ─── */
  function addBgStars(n = 120) {
    if (!stage) return;
    for (let i = 0; i < n; i++) {
      const s = document.createElement('div');
      s.className = 'bg-star';
      const sz = Math.random() < 0.1 ? 2 : Math.random() < 0.4 ? 1.5 : 1;
      s.style.cssText = `
        width:${sz}px; height:${sz}px;
        left:${Math.random()*100}%;
        top:${Math.random()*100}%;
        --dur:${(2 + Math.random()*4).toFixed(1)}s;
        --delay:-${(Math.random()*4).toFixed(1)}s;
      `;
      stage.appendChild(s);
    }
  }

  /* ─── BUILD CONSTELLATIONS ─── */
  function buildConstellations() {
    if (!stage || !skySvg) return;
    // clear old
    Object.keys(starsMap).forEach(id => {
      starsMap[id]?.forEach(el => el.remove());
    });
    Object.keys(linesMap).forEach(id => {
      linesMap[id]?.forEach(el => el.remove());
    });
    Object.keys(labelsMap).forEach(id => labelsMap[id]?.remove());
    Object.keys(hitMap).forEach(id => hitMap[id]?.remove());
    skySvg.innerHTML = '';

    const W = stage.clientWidth;
    const H = stage.clientHeight;

    const toolIds = Object.keys(geo);
    const breathDurs = [3.5, 4.2, 5, 3.8, 4.6, 3.2, 4.9];

    toolIds.forEach((id, ci) => {
      const g = geo[id];
      const cx = g.pos[0] * W;
      const cy = g.pos[1] * H;
      const scale = Math.min(W, H) < 500 ? 0.60 : 1.00;
      const cSize = CONST_SIZE * scale;

      // map star local coords -> screen coords
      function starPos(sx, sy) {
        return {
          x: cx + (sx / 100 - 0.5) * cSize,
          y: cy + (sy / 100 - 0.5) * cSize,
        };
      }

      // lines
      linesMap[id] = [];
      g.lines.forEach(([a, b]) => {
        const pa = starPos(g.stars[a][0], g.stars[a][1]);
        const pb = starPos(g.stars[b][0], g.stars[b][1]);
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', String(pa.x.toFixed(1)));
        line.setAttribute('y1', String(pa.y.toFixed(1)));
        line.setAttribute('x2', String(pb.x.toFixed(1)));
        line.setAttribute('y2', String(pb.y.toFixed(1)));
        line.setAttribute('class', 'c-line');
        line.dataset.id = id;
        skySvg.appendChild(line);
        linesMap[id].push(line);
      });

      // stars
      starsMap[id] = [];
      g.stars.forEach(([sx, sy], si) => {
        const pos = starPos(sx, sy);
        const el = document.createElement('div');
        const size = si === 0 ? 's-lg' : (si % 3 === 0 ? 's-md' : 's-sm');
        el.className = `c-star ${size}`;
        el.dataset.id = id;
        el.style.left = pos.x + 'px';
        el.style.top  = pos.y + 'px';
        el.style.setProperty('--bdur', breathDurs[ci % breathDurs.length] + 's');
        el.style.setProperty('--bdelay', -(ci * 0.7).toFixed(1) + 's');
        stage.appendChild(el);
        starsMap[id].push(el);
      });

      // label at center
      const label = document.createElement('div');
      label.className = 'c-label';
      label.dataset.id = id;
      label.style.left = cx + 'px';
      label.style.top  = cy + 'px';
      const copyCurrent = copy[currentLang]?.[id] ?? copy['en']?.[id];
      label.innerHTML = copyCurrent?.name ?? id;
      stage.appendChild(label);
      labelsMap[id] = label;

      // hit area
      const hit = document.createElement('div');
      hit.className = 'c-hit';
      hit.dataset.id = id;
      hit.style.left = cx + 'px';
      hit.style.top  = cy + 'px';
      hit.addEventListener('mouseenter', () => selectTool(id));
      hit.addEventListener('mouseleave', clearTool);
      hit.addEventListener('click', () => selectTool(id));
      stage.appendChild(hit);
      hitMap[id] = hit;
    });
  }

  /* ─── PANEL ─── */
  function selectTool(id) {
    activeId = id;
    highlightConstellation(id);
    showDetail(id);
  }

  function clearTool() {
    activeId = null;
    clearHighlight();
    showEmpty();
  }

  function showDetail(id) {
    if (!panelEmpty || !panelDetail) return;
    const c = copy[currentLang]?.[id] ?? copy['en']?.[id];
    if (!c) return;
    const dCat   = document.getElementById('d-cat');   if (dCat)   dCat.textContent  = c.cat;
    const dName  = document.getElementById('d-name');  if (dName)  dName.innerHTML   = c.name;
    const dUsage = document.getElementById('d-usage'); if (dUsage) dUsage.textContent = c.usage;
    const dText  = document.getElementById('d-text');  if (dText)  dText.innerHTML   = c.text;
    const dTags  = document.getElementById('d-tags');  if (dTags)  dTags.innerHTML   = c.tags.map(t => `<span class="detail-tag">${t}</span>`).join('');
    panelEmpty.classList.add('hidden');
    panelDetail.classList.remove('hidden');
  }

  function showEmpty() {
    panelEmpty?.classList.remove('hidden');
    panelDetail?.classList.add('hidden');
  }

  /* ─── HIGHLIGHT ─── */
  function highlightConstellation(id) {
    Object.keys(starsMap).forEach(cid => {
      const active = cid === id;
      starsMap[cid]?.forEach(el => { el.classList.toggle('lit', active); el.classList.toggle('dim', !active); });
      linesMap[cid]?.forEach(el => { el.classList.toggle('lit', active); el.classList.toggle('dim', !active); });
      labelsMap[cid]?.classList.toggle('lit', active);
      labelsMap[cid]?.classList.toggle('dim', !active);
    });
  }

  function clearHighlight() {
    Object.keys(starsMap).forEach(cid => {
      starsMap[cid]?.forEach(el => { el.classList.remove('lit', 'dim'); });
      linesMap[cid]?.forEach(el => { el.classList.remove('lit', 'dim'); });
      labelsMap[cid]?.classList.remove('lit', 'dim');
    });
  }

  /* ─── LANG CHANGE ─── */
  function updateLabels() {
    Object.keys(labelsMap).forEach(id => {
      const el = labelsMap[id];
      if (!el) return;
      const c = copy[currentLang]?.[id] ?? copy['en']?.[id];
      if (c) el.innerHTML = c.name;
    });
    if (activeId) showDetail(activeId);
  }

  window.addEventListener('langchange', (e) => {
    currentLang = e.detail.lang;
    updateLabels();
  });

  /* ─── INIT ─── */
  addBgStars();
  buildConstellations();

  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => { buildConstellations(); if (activeId) highlightConstellation(activeId); }, 200);
  });
</script>

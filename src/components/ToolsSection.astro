---
import { toolsMeta, toolsCopy, toolGroups } from '../data/tools';
import { i18n } from '../scripts/i18n';
const copyJSON = JSON.stringify(toolsCopy);
const en = toolsCopy.en;
const ui = i18n.en;

let cursor = 0;
const groups = toolGroups.map((g) => {
  const items = toolsMeta.slice(cursor, cursor + g.count);
  cursor += g.count;
  return { ...g, items };
});
---

<section class="tools" id="tools">
  <div class="section-head" data-story-rule>
    <h2 class="section-title" data-story="words" data-i18n="tools_title">AI &amp; <em>Tools</em></h2>
    <span class="section-aside" data-i18n="tools_aside">Nine processes · running</span>
  </div>

  <div class="term" data-story="fade-up">
    <div class="term-bar" aria-hidden="true">
      <span class="term-dots"><i></i><i></i><i></i></span>
      <span class="term-title">mg@portfolio: ~/ai-stack</span>
    </div>

    <div class="term-body">
      {groups.map((g, gi) => (
        <div class="term-exchange">
          <p class="term-cmd term-q">
            <span class="term-prompt" aria-hidden="true">$</span>
            <span class="q-typed" data-i18n={g.qKey}>{(ui as any)[g.qKey]}</span><span class="term-cursor" aria-hidden="true"></span>
          </p>
          <p class="term-ans" data-i18n={g.aKey}>{(ui as any)[g.aKey]}</p>
          {gi === 0 && (
            <p class="term-cols" aria-hidden="true">
              <span>NAME</span><span>STATUS</span><span>CATEGORY</span><span>FREQ</span><span class="col-load">LOAD</span>
            </p>
          )}
          <ol class="term-list">
            {g.items.map((t) => {
              const c = en[t.id];
              return (
                <li class="term-row" data-tool={t.id}>
                  <div class="row-main">
                    <span class="row-name" data-t-field="name" set:html={c.name} />
                    <span class={`row-status st-${t.status}`}>[{t.status}]</span>
                    <span class="row-cat" data-t-field="cat">{c.cat}</span>
                    <span class="row-usage" data-t-field="usage">{c.usage}</span>
                    <span class="row-load" role="img" aria-label={`usage intensity ${t.intensity} of 5`}>
                      {[1, 2, 3, 4, 5].map((i) => <i class={i <= t.intensity ? 'on' : ''} />)}
                    </span>
                  </div>
                  <p class="row-text" data-t-field="text" set:html={c.text} />
                  <p class="row-tags" data-t-field="tags">{c.tags.map((tag) => `#${tag}`).join('  ')}</p>
                </li>
              );
            })}
          </ol>
        </div>
      ))}

      <p class="term-cmd term-end" aria-hidden="true">
        <span class="term-prompt">$</span><span class="term-cursor blink"></span>
      </p>
    </div>
  </div>

  <p class="tools-footnote" data-i18n="tools_footnote">
    Models change every season. The craft of working with them — what to ask, when to trust, when to ignore — is the real stack now.
  </p>
</section>

<style is:global>
  .tools {
    padding: 6rem var(--pad) 4rem;
    max-width: var(--max); margin: 0 auto;
  }
  .tools .section-head {
    display: flex; justify-content: space-between; align-items: baseline;
    border-top: 1px solid var(--rule); padding-top: 0.85rem; margin-bottom: 3rem;
  }

  /* ── Terminal frame ── */
  .term {
    background: #0D0C0A;
    border: 1px solid rgba(201, 192, 174, 0.18);
    border-radius: 8px;
    overflow: hidden;
  }
  .term-bar {
    display: flex; align-items: center; gap: 0.9rem;
    background: #151310;
    border-bottom: 1px solid rgba(242, 238, 229, 0.07);
    padding: 0.6rem 1.1rem;
  }
  .term-dots { display: flex; gap: 0.4rem; }
  .term-dots i {
    width: 9px; height: 9px; border-radius: 50%;
    background: rgba(242, 238, 229, 0.16);
  }
  .term-title {
    font-family: var(--mono); font-size: 0.62rem;
    letter-spacing: 0.08em; color: rgba(242, 238, 229, 0.5);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  .term-body {
    position: relative;
    padding: 1.4rem 1.5rem 1.2rem;
  }
  /* subtle static scanlines */
  .term-body::after {
    content: '';
    position: absolute; inset: 0;
    background: repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0, 0, 0, 0.12) 2px 3px);
    pointer-events: none;
  }

  /* ── Dialogue lines ── */
  .term-cmd {
    display: flex; align-items: center; gap: 0.55rem;
    font-family: var(--mono); font-size: 0.78rem;
    color: rgba(242, 238, 229, 0.85);
    min-height: 1.4em;
    margin-bottom: 0.5rem;
  }
  .term-q { margin-top: 0.9rem; }
  .term-exchange:first-child .term-q { margin-top: 0; }
  .term-cmd.term-end { margin: 1rem 0 0; }
  .term-prompt { color: var(--burgundy-soft); }
  .term-ans {
    font-family: var(--mono); font-size: 0.72rem;
    color: rgba(242, 238, 229, 0.55);
    margin: 0 0 0.9rem 1.15rem;
  }
  .term-cursor {
    display: inline-block; width: 0.55em; height: 1.05em;
    background: rgba(242, 238, 229, 0.8);
    vertical-align: text-bottom;
    margin-left: 2px;
    opacity: 0;
  }
  .term-q.q-active .term-cursor { opacity: 1; }
  .term-end .term-cursor { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .term-cursor.blink { animation: cursor-blink 1.1s steps(1) infinite; }
  }
  @keyframes cursor-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  /* ── Column headers + row grid ── */
  .term-cols,
  .row-main {
    display: grid;
    grid-template-columns: minmax(9.5rem, max-content) 3.5rem 1fr max-content 5.5rem;
    gap: 1rem;
    align-items: baseline;
  }
  .term-cols {
    font-family: var(--mono); font-size: 0.58rem;
    letter-spacing: 0.14em;
    color: rgba(242, 238, 229, 0.35);
    padding: 0 0.75rem 0.5rem;
  }
  .term-cols .col-load { text-align: left; }

  /* ── Rows ── */
  .term-list { list-style: none; margin: 0; padding: 0; }
  .term-row {
    padding: 0.85rem 0.75rem;
    border-top: 1px solid rgba(242, 238, 229, 0.07);
    transition: background 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .term-row:hover {
    background: rgba(242, 238, 229, 0.035);
    box-shadow: inset 2px 0 0 var(--burgundy-soft);
  }
  .row-name {
    font-family: var(--mono); font-size: 0.8rem; font-weight: 500;
    color: #F2EEE5;
  }
  .row-name em { font-style: italic; font-weight: 400; color: rgba(242, 238, 229, 0.75); }
  .term-row:hover .row-name { color: #fff; }
  .row-status {
    font-family: var(--mono); font-size: 0.66rem;
    letter-spacing: 0.05em;
  }
  .row-status.st-run { color: rgba(242, 238, 229, 0.6); }
  .row-status.st-exp { color: var(--burgundy-soft); }
  .row-cat {
    font-family: var(--mono); font-size: 0.66rem;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: rgba(242, 238, 229, 0.5);
  }
  .row-usage {
    font-family: var(--mono); font-size: 0.66rem;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: rgba(242, 238, 229, 0.7);
  }
  .row-load { display: inline-flex; gap: 3px; align-self: center; }
  .row-load i {
    width: 8px; height: 8px;
    background: rgba(242, 238, 229, 0.14);
  }
  .row-load i.on { background: var(--burgundy-soft); }

  .row-text {
    font-family: var(--sans); font-size: 0.8rem;
    color: rgba(242, 238, 229, 0.68);
    line-height: 1.65;
    margin: 0.45rem 0 0;
    max-width: 62ch;
  }
  .row-text strong { color: rgba(242, 238, 229, 0.92); font-weight: 500; }
  .row-tags {
    font-family: var(--mono); font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: rgba(242, 238, 229, 0.38);
    margin: 0.35rem 0 0;
    white-space: pre-wrap;
  }

  /* ── Responsive ── */
  @media (max-width: 700px) {
    .term-body { padding: 1.1rem 1rem 1rem; }
    .term-cols { display: none; }
    .row-main {
      display: flex; flex-wrap: wrap;
      column-gap: 0.75rem; row-gap: 0.15rem;
      align-items: baseline;
    }
    .term-row { padding: 1rem 0.5rem; }
    .row-load { flex-basis: 100%; margin-top: 0.35rem; }
  }

  .tools-footnote {
    font-family: var(--mono); font-size: 0.62rem;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-mute);
    margin-top: 1.25rem; text-align: center; line-height: 1.8;
  }
</style>

<script define:vars={{ copyJSON }}>
  const copy = JSON.parse(copyJSON);

  /* ─── LANG CHANGE (tool rows; questions/answers handled by applyLang) ─── */
  window.addEventListener('langchange', (e) => {
    const lang = e.detail.lang;
    document.querySelectorAll('.term-row[data-tool]').forEach((row) => {
      const id = row.dataset.tool;
      const c = copy[lang]?.[id] ?? copy['en']?.[id];
      if (!c) return;
      const name = row.querySelector('[data-t-field="name"]');
      const cat = row.querySelector('[data-t-field="cat"]');
      const usage = row.querySelector('[data-t-field="usage"]');
      const text = row.querySelector('[data-t-field="text"]');
      const tags = row.querySelector('[data-t-field="tags"]');
      if (name) name.innerHTML = c.name;
      if (cat) cat.textContent = c.cat;
      if (usage) usage.textContent = c.usage;
      if (text) text.innerHTML = c.text;
      if (tags) tags.textContent = c.tags.map((t) => `#${t}`).join('  ');
    });
  });

  /* ─── CHAT SEQUENCE + REPLAY (progressive enhancement) ───
     Types each question, prints its answer and its rows, exchange by
     exchange. Resets and replays every time the terminal re-enters the
     viewport. Without the story gate everything is visible statically. */
  const term = document.querySelector('.term');
  const termEnd = document.querySelector('.term-cmd.term-end');
  const exchanges = Array.from(document.querySelectorAll('.term-exchange'));
  const gated = document.documentElement.classList.contains('story');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (term && exchanges.length && gated && !reduced) {
    let timeouts = [];
    let running = false;
    const schedule = (fn, ms) => timeouts.push(window.setTimeout(fn, ms));

    const resetSeq = () => {
      timeouts.forEach(clearTimeout);
      timeouts = [];
      running = false;
      term.querySelectorAll('.row-on').forEach((el) => el.classList.remove('row-on'));
      term.querySelectorAll('.a-on').forEach((el) => el.classList.remove('a-on'));
      exchanges.forEach((ex) => {
        const q = ex.querySelector('.q-typed');
        const qLine = ex.querySelector('.term-q');
        if (q.textContent.trim()) q.dataset.full = q.textContent;
        q.textContent = '';
        qLine.classList.remove('q-active');
      });
    };

    const runSeq = () => {
      if (running) return;
      running = true;
      let t = 200;
      exchanges.forEach((ex) => {
        const q = ex.querySelector('.q-typed');
        const qLine = ex.querySelector('.term-q');
        const full = q.dataset.full ?? '';
        schedule(() => qLine.classList.add('q-active'), t);
        for (let c = 1; c <= full.length; c++) {
          schedule(() => { q.textContent = full.slice(0, c); }, t + c * 32);
        }
        t += full.length * 32 + 300;
        schedule(() => {
          qLine.classList.remove('q-active');
          ex.querySelector('.term-ans')?.classList.add('a-on');
        }, t);
        t += 260;
        const cols = ex.querySelector('.term-cols');
        if (cols) {
          schedule(() => cols.classList.add('row-on'), t);
          t += 150;
        }
        ex.querySelectorAll('.term-row').forEach((row) => {
          schedule(() => row.classList.add('row-on'), t);
          t += 130;
        });
        t += 420;
      });
      schedule(() => termEnd?.classList.add('row-on'), t);
    };

    resetSeq();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            runSeq();
          } else {
            resetSeq();
          }
        });
      },
      { threshold: 0.25 }
    );
    observer.observe(term);
  }
</script>

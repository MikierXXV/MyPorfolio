---
// WorkSection — responsive grid with 7 project cards + project modals
import { projectLinks } from '../data/projects';
const gh = (id: string) => projectLinks[id]?.github;
---

<section class="section" id="work">
  <div class="section-tag" data-story-rule>
    <span class="section-num">I.</span>
    <h2 class="section-title" data-story="mask-up" data-i18n="work_title">Selected <em>Work</em></h2>
    <span class="section-aside" data-i18n="work_aside">Seven pieces · code &amp; details on each card</span>
  </div>

  <div class="work-grid" data-story="stagger" data-story-items=".work-card">

    <!-- 01 — BS Frontend -->
    <article class="work-card" data-project="bsfront" tabindex="0" role="button">
      <div class="work-card-head"><span class="work-card-num">01</span><span class="work-card-year">2026 · May</span></div>
      <div class="work-art-frame">
        <svg class="work-art" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid meet">
          <g fill="none" stroke="currentColor" stroke-width="1">
            <rect x="60" y="30" width="280" height="20"/><rect x="80" y="60" width="240" height="20"/>
            <rect x="100" y="90" width="200" height="20"/><rect x="120" y="120" width="160" height="20"/>
            <rect x="140" y="150" width="120" height="20"/>
          </g>
          <g fill="currentColor">
            <circle cx="200" cy="40" r="2.5"/><circle cx="200" cy="70" r="2.5"/>
            <circle cx="200" cy="100" r="2.5"/><circle cx="200" cy="130" r="2.5"/>
            <circle cx="200" cy="160" r="2.5"/>
          </g>
          <g fill="none" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 2">
            <line x1="200" y1="42" x2="200" y2="68"/><line x1="200" y1="72" x2="200" y2="98"/>
            <line x1="200" y1="102" x2="200" y2="128"/><line x1="200" y1="132" x2="200" y2="158"/>
          </g>
          <text x="200" y="195" text-anchor="middle" font-family="JetBrains Mono" font-size="9" fill="currentColor" opacity="0.5">presentation · application · domain · infra · shared</text>
        </svg>
      </div>
      <div class="work-card-body">
        <h3 class="work-card-title">Health Care <em data-i18n="work_bsfront_em">— Frontend</em></h3>
        <p class="work-card-desc" data-i18n="work_bsfront_desc">Hospital-management SPA shipped to Vercel: Vue 3 + TypeScript in a 5-layer Clean Architecture. 24 views, 33+ components, RBAC, OAuth2, dark mode, 3-language i18n. Vitest (80% coverage target) + Playwright E2E.</p>
        <div class="work-card-foot">
          <span class="tag">Vue 3</span><span class="tag">TypeScript</span><span class="tag">Pinia</span><span class="tag">Tailwind</span>
          <a class="tag tag-link" href={gh('bsfront')} target="_blank" rel="noopener" data-i18n="work_link_code">Code ↗</a>
          <span class="arrow">→</span>
        </div>
      </div>
    </article>

    <!-- 02 — BS Backend -->
    <article class="work-card" data-project="bsback" tabindex="0" role="button">
      <div class="work-card-head"><span class="work-card-num">02</span><span class="work-card-year">2026 · May</span></div>
      <div class="work-art-frame">
        <svg class="work-art" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid meet">
          <g fill="none" stroke="currentColor" stroke-width="1">
            <polygon points="200,40 290,75 290,135 200,170 110,135 110,75"/>
            <polygon points="200,70 240,95 240,125 200,150 160,125 160,95"/>
            <circle cx="200" cy="40" r="3.5"/><circle cx="290" cy="75" r="3.5"/>
            <circle cx="290" cy="135" r="3.5"/><circle cx="200" cy="170" r="3.5"/>
            <circle cx="110" cy="135" r="3.5"/><circle cx="110" cy="75" r="3.5"/>
          </g>
          <g fill="currentColor"><circle cx="200" cy="110" r="3"/></g>
          <text x="200" y="195" text-anchor="middle" font-family="JetBrains Mono" font-size="9" fill="currentColor" opacity="0.5">domain · application · infra · interfaces</text>
        </svg>
      </div>
      <div class="work-card-body">
        <h3 class="work-card-title">Health Care <em data-i18n="work_bsback_em">— Backend</em></h3>
        <p class="work-card-desc" data-i18n="work_bsback_desc">Enterprise-grade auth API: hexagonal architecture with 30 use cases, JWT with refresh-token rotation, OAuth2, RBAC, progressive account lockout, rate limiting. Node + TypeScript + PostgreSQL, Dockerized.</p>
        <div class="work-card-foot">
          <span class="tag">Node</span><span class="tag">TypeScript</span><span class="tag">Express</span><span class="tag">PostgreSQL</span>
          <a class="tag tag-link" href={gh('bsback')} target="_blank" rel="noopener" data-i18n="work_link_code">Code ↗</a>
          <span class="arrow">→</span>
        </div>
      </div>
    </article>

    <!-- 03 — Unimoodle -->
    <article class="work-card" data-project="unimoodle" tabindex="0" role="button">
      <div class="work-card-head"><span class="work-card-num">03</span><span class="work-card-year">2024 · Jan</span></div>
      <div class="work-art-frame">
        <svg class="work-art" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid meet">
          <g fill="none" stroke="currentColor" stroke-width="1">
            <circle cx="80" cy="100" r="20"/><circle cx="200" cy="60" r="14"/>
            <circle cx="200" cy="140" r="14"/><circle cx="320" cy="100" r="20"/>
            <circle cx="140" cy="100" r="6"/><circle cx="260" cy="100" r="6"/>
            <line x1="100" y1="100" x2="194" y2="62"/><line x1="100" y1="100" x2="194" y2="138"/>
            <line x1="214" y1="60" x2="300" y2="100"/><line x1="214" y1="140" x2="300" y2="100"/>
            <line x1="100" y1="100" x2="140" y2="100"/><line x1="260" y1="100" x2="300" y2="100"/>
          </g>
          <text x="200" y="195" text-anchor="middle" font-family="JetBrains Mono" font-size="9" fill="currentColor" opacity="0.5">plugin · gradebook · export</text>
        </svg>
      </div>
      <div class="work-card-body">
        <h3 class="work-card-title">Unimoodle <em data-i18n="work_1_em">plugins</em></h3>
        <p class="work-card-desc" data-i18n="work_1_desc">Grading-formula editor and data-export plugins for Moodle, built for a consortium of 15 Spanish universities — integrated into Moodle core UI without breaking accessibility.</p>
        <div class="work-card-foot">
          <span class="tag">PHP</span><span class="tag">Moodle</span><span class="tag">JS</span>
          <span class="arrow">→</span>
        </div>
      </div>
    </article>

    <!-- 04 — Green Wheel -->
    <article class="work-card" data-project="greenwheel" tabindex="0" role="button">
      <div class="work-card-head"><span class="work-card-num">04</span><span class="work-card-year">2023 · May</span></div>
      <div class="work-art-frame">
        <svg class="work-art" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid meet">
          <g fill="none" stroke="currentColor" stroke-width="1">
            <path d="M 60 50 L 100 30 L 160 60 L 220 35 L 280 70 L 340 50" stroke-dasharray="2 4"/>
            <path d="M 80 130 L 140 110 L 200 140 L 260 115 L 320 150" stroke-dasharray="2 4"/>
          </g>
          <g fill="currentColor">
            <circle cx="100" cy="30" r="4"/><circle cx="220" cy="35" r="4"/>
            <circle cx="160" cy="60" r="4"/><circle cx="280" cy="70" r="4"/>
            <circle cx="140" cy="110" r="4"/><circle cx="260" cy="115" r="4"/>
          </g>
          <g fill="none" stroke="currentColor" stroke-width="1">
            <circle cx="100" cy="30" r="14"/><circle cx="280" cy="70" r="14"/>
          </g>
          <text x="200" y="195" text-anchor="middle" font-family="JetBrains Mono" font-size="9" fill="currentColor" opacity="0.5">map · chargers · bikes</text>
        </svg>
      </div>
      <div class="work-card-body">
        <h3 class="work-card-title">Green Wheel <em data-i18n="work_2_em">app</em></h3>
        <p class="work-card-desc" data-i18n="work_2_desc">Led the frontend team of a 7-person squad building a Flutter app to reserve EV chargers and bikes — maps, reservations, chat and ratings delivered across three Agile sprints.</p>
        <div class="work-card-foot">
          <span class="tag">Flutter</span><span class="tag">Dart</span><span class="tag">Python</span>
          <span class="arrow">→</span>
        </div>
      </div>
    </article>

    <!-- 05 — Data Mining -->
    <article class="work-card" data-project="datamining" tabindex="0" role="button">
      <div class="work-card-head"><span class="work-card-num">05</span><span class="work-card-year">2023 · May</span></div>
      <div class="work-art-frame">
        <svg class="work-art" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid meet">
          <g stroke="currentColor" stroke-width="1" fill="none">
            <line x1="40" y1="160" x2="370" y2="160"/>
            <line x1="40" y1="40" x2="40" y2="160"/>
            <line x1="40" y1="120" x2="370" y2="50" stroke-dasharray="3 3"/>
          </g>
          <g fill="currentColor">
            <circle cx="70" cy="140" r="3"/><circle cx="100" cy="130" r="3"/>
            <circle cx="130" cy="115" r="3"/><circle cx="160" cy="125" r="3"/>
            <circle cx="190" cy="100" r="3"/><circle cx="220" cy="90" r="3"/>
            <circle cx="250" cy="85" r="3"/><circle cx="280" cy="70" r="3"/>
            <circle cx="310" cy="65" r="3"/><circle cx="340" cy="55" r="3"/>
            <circle cx="90" cy="155" r="3"/><circle cx="140" cy="148" r="3"/>
            <circle cx="200" cy="135" r="3"/><circle cx="240" cy="120" r="3"/>
            <circle cx="290" cy="105" r="3"/>
          </g>
          <text x="200" y="190" text-anchor="middle" font-family="JetBrains Mono" font-size="9" fill="currentColor" opacity="0.5">clustering · PCA · regression</text>
        </svg>
      </div>
      <div class="work-card-body">
        <h3 class="work-card-title">Data Mining <em data-i18n="work_3_em">studies</em></h3>
        <p class="work-card-desc" data-i18n="work_3_desc">Uncovered gender pay-gap drivers with clustering + PCA in R, and predicted NBA player positions with tuned classification models in Python — end-to-end, interpretable pipelines.</p>
        <div class="work-card-foot">
          <span class="tag">Python</span><span class="tag">R</span><span class="tag">ML</span>
          <span class="arrow">→</span>
        </div>
      </div>
    </article>

  </div><!-- /work-grid -->

  <div class="work-more-wrap">
    <button class="work-more" id="workMore" aria-expanded="false" aria-controls="work-early" data-i18n="work_more_btn">+ Early work · 2 more</button>
  </div>

  <div id="work-early" hidden>
  <p class="work-early-label" data-i18n="work_early_label">Early work</p>

  <div class="work-grid work-grid-early">

    <!-- 06 — Lay Up -->
    <article class="work-card compact" data-project="layup" tabindex="0" role="button">
      <div class="work-card-head"><span class="work-card-num">06</span><span class="work-card-year">2020 · Mar</span></div>
      <div class="work-card-body">
        <h3 class="work-card-title">Lay Up <em data-i18n="work_4_em">ecommerce</em></h3>
        <p class="work-card-desc" data-i18n="work_4_desc">Where it started — ecommerce frontend for a fashion brand with login and cart. HTML, CSS, JS, Bootstrap.</p>
        <div class="work-card-foot">
          <span class="tag">HTML</span><span class="tag">CSS</span><span class="tag">JS</span><span class="tag">Bootstrap</span>
          <a class="tag tag-link" href={gh('layup')} target="_blank" rel="noopener" data-i18n="work_link_code">Code ↗</a>
          <span class="arrow">→</span>
        </div>
      </div>
    </article>

    <!-- 07 — Wishlist -->
    <article class="work-card compact" data-project="wishlist" tabindex="0" role="button">
      <div class="work-card-head"><span class="work-card-num">07</span><span class="work-card-year">2019 · Dec</span></div>
      <div class="work-card-body">
        <h3 class="work-card-title">Wishlist <em data-i18n="work_5_em">JS</em></h3>
        <p class="work-card-desc" data-i18n="work_5_desc">A React study in making time visible — items decay green→orange→red as they wait.</p>
        <div class="work-card-foot">
          <span class="tag">React</span><span class="tag">JS</span>
          <a class="tag tag-link" href={gh('wishlist')} target="_blank" rel="noopener" data-i18n="work_link_code">Code ↗</a>
          <span class="arrow">→</span>
        </div>
      </div>
    </article>

  </div><!-- /work-grid-early -->
  </div><!-- /work-early -->
</section>

<!-- ============ PROJECT MODALS ============ -->
<div class="modal-backdrop" id="modal-project">
  <div class="modal" id="projectModal" data-lenis-prevent>
    <button class="modal-close" data-close>×</button>
    <div class="modal-eyebrow" id="pmEyebrow">Project</div>
    <h2 class="modal-title" id="pmTitle"></h2>
    <div class="project-meta-row" id="pmTags"></div>
    <div class="project-links" id="pmLinks"></div>
    <div class="project-gallery" id="pmGallery"></div>
    <div class="project-prose" id="pmProse" style="margin-top:1.5rem;"></div>
  </div>
</div>

<style>
  /* ===== SECTION HEADER (shared pattern) ===== */
  .section { max-width: var(--max); margin: 0 auto; padding: 7rem var(--pad) 3rem; position: relative; }
  .section-tag {
    display: grid; grid-template-columns: auto 1fr auto;
    gap: 1.5rem; align-items: baseline;
    margin-bottom: 4rem;
    border-top: 1px solid var(--ink); padding-top: 1rem;
  }
  .section-num { font-family: var(--serif); font-style: italic; font-size: 1.05rem; color: var(--ink); }
  .section-title {
    font-family: var(--serif); font-weight: 300;
    font-size: clamp(2rem, 5vw, 4rem);
    letter-spacing: -0.025em; line-height: 1;
  }
  .section-title em { font-style: italic; font-weight: 400; }
  .section-aside { font-family: var(--mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-mute); }
  @media (max-width: 640px) {
    .section-tag { grid-template-columns: auto 1fr; }
    .section-aside { grid-column: 1 / -1; }
  }

  /* ===== WORK GRID ===== */
  .work-grid {
    display: grid; grid-template-columns: 1fr; gap: 1.25rem;
  }
  @media (min-width: 800px) {
    .work-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .work-more-wrap { display: flex; justify-content: center; margin-top: 2rem; }
  .work-more {
    font-family: var(--mono); font-size: 0.68rem;
    text-transform: uppercase; letter-spacing: 0.14em;
    background: transparent; border: 1px solid var(--rule); border-radius: 100px;
    padding: 0.7rem 1.6rem; color: var(--ink-mute); cursor: pointer;
    transition: color .3s, border-color .3s, background .3s;
  }
  .work-more:hover { color: var(--paper); background: var(--ink); border-color: var(--ink); }

  .work-early-label {
    font-family: var(--mono); font-size: 0.7rem;
    text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-mute);
    margin: 2.5rem 0 1.25rem;
    border-top: 1px solid var(--rule); padding-top: 0.85rem;
  }

  .work-card {
    background: var(--paper-2); border: 1px solid var(--rule);
    padding: 2rem; display: grid; grid-template-rows: auto 1fr auto;
    gap: 1.25rem; position: relative; overflow: hidden;
    cursor: pointer; transition: background .4s, color .4s, transform .4s;
  }
  @media (max-width: 540px) { .work-card { padding: 1.5rem; } }
  .work-card:hover, .work-card:focus-visible { background: var(--ink); color: var(--paper); }
  .work-card:focus-visible { outline: 2px solid var(--burgundy); outline-offset: 2px; }
  .work-card:hover .work-art path,
  .work-card:hover .work-art circle,
  .work-card:hover .work-art rect,
  .work-card:hover .work-art line,
  .work-card:hover .work-art ellipse { stroke: currentColor; }

  .work-card.compact { grid-template-rows: auto auto; }
  .work-card.compact .work-card-num { font-size: 1.5rem; }

  .work-card-head {
    display: flex; justify-content: space-between; align-items: baseline;
    font-family: var(--mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em;
  }
  .work-card-num { font-family: var(--serif); font-style: italic; font-size: 2.2rem; font-weight: 300; line-height: 1; }
  .work-card-year { font-family: var(--mono); font-size: 0.7rem; opacity: 0.7; }

  .work-art-frame {
    aspect-ratio: 16 / 9; border: 1px solid currentColor;
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
  }
  .work-art { width: 100%; height: 100%; }
  .work-art path, .work-art circle, .work-art rect, .work-art line, .work-art ellipse { transition: stroke .4s; }

  .work-card-body { display: grid; gap: 0.75rem; align-content: end; }
  .work-card-title { font-family: var(--serif); font-weight: 400; font-size: clamp(1.4rem, 2.5vw, 2rem); line-height: 1.1; letter-spacing: -0.02em; }
  .work-card-title em { font-style: italic; opacity: 0.65; }
  .work-card-desc { font-size: 0.92rem; opacity: 0.85; max-width: 50ch; }
  .work-card-foot { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .work-card-foot .tag {
    font-family: var(--mono); font-size: 0.6rem; padding: 0.18rem 0.55rem;
    border: 1px solid currentColor; border-radius: 100px; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.85;
  }
  .work-card-foot .tag-link {
    color: inherit; text-decoration: none; opacity: 1;
    background: var(--burgundy); border-color: var(--burgundy); color: var(--paper);
    transition: background .3s, border-color .3s;
  }
  .work-card-foot .tag-link:hover { background: var(--burgundy-soft); border-color: var(--burgundy-soft); }
  .work-card-foot .arrow { margin-left: auto; font-family: var(--serif); font-size: 1.4rem; transition: transform .4s; }
  .work-card:hover .work-card-foot .arrow { transform: translateX(8px); }

  /* ===== PROJECT MODAL ===== */
  .modal-backdrop {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(26, 22, 18, 0.75); backdrop-filter: blur(8px);
    display: none; align-items: center; justify-content: center;
    padding: 2rem; opacity: 0; transition: opacity .35s;
  }
  .modal-backdrop.open { display: flex; opacity: 1; }
  .modal {
    background: var(--paper); border: 1px solid var(--ink);
    max-width: 900px; width: 100%; max-height: 90vh;
    overflow-y: auto; overflow-x: hidden;
    padding: 2.5rem; position: relative;
    transform: scale(0.96); transition: transform .4s var(--ease);
  }
  @media (max-width: 640px) { .modal { padding: 1.5rem; max-height: 95vh; } }
  .modal-backdrop.open .modal { transform: scale(1); }
  .modal-close {
    position: absolute; top: 1rem; right: 1rem;
    width: 36px; height: 36px; background: transparent; border: 1px solid var(--ink);
    color: var(--ink); cursor: pointer; font-family: var(--serif); font-size: 1.2rem;
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    transition: background .3s, color .3s;
  }
  .modal-close:hover { background: var(--ink); color: var(--paper); }
  .modal-eyebrow { font-family: var(--mono); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--ink-mute); margin-bottom: 0.5rem; }
  .modal-title { font-family: var(--serif); font-weight: 300; font-size: clamp(1.8rem, 4vw, 2.6rem); letter-spacing: -0.02em; margin-bottom: 1.5rem; line-height: 1.1; }
  .modal-title em { font-style: italic; }
  .project-meta-row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.5rem 0 1rem; }
  .project-meta-row :global(.tag) { font-family: var(--mono); font-size: 0.6rem; padding: 0.18rem 0.55rem; border: 1px solid var(--rule); border-radius: 100px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-mute); }
  .project-links { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .project-links:empty { display: none; }
  :global(.project-link) {
    font-family: var(--mono); font-size: 0.62rem; padding: 0.35rem 0.9rem;
    border-radius: 100px; text-transform: uppercase; letter-spacing: 0.1em;
    background: var(--burgundy); border: 1px solid var(--burgundy); color: var(--paper);
    text-decoration: none; transition: background .3s, border-color .3s;
  }
  :global(.project-link:hover) { background: var(--burgundy-soft); border-color: var(--burgundy-soft); }
  .project-gallery { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 640px) { .project-gallery { grid-template-columns: repeat(2, 1fr); } }
  .project-gallery :global(.project-image) { background: var(--paper-2); border: 1px solid var(--rule); aspect-ratio: 4 / 3; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .project-gallery :global(.project-image img) { width: 100%; height: 100%; object-fit: contain; padding: 1rem; }
  .project-prose { font-size: 0.95rem; line-height: 1.65; color: var(--ink-soft); max-width: 65ch; }
  .project-prose :global(p + p) { margin-top: 0.85rem; }
  .project-prose :global(ul) {
    margin: 0.85rem 0; padding-left: 1.15rem;
    display: grid; gap: 0.4rem;
  }
  .project-prose :global(li) { padding-left: 0.2rem; }
  .project-prose :global(li)::marker { color: var(--burgundy); }
</style>

<script>
  import { projectData, projectLinks, workCards, ASSET_BASE } from '../data/projects';
  import { i18n } from '../scripts/i18n';
  import type { Lang } from '../scripts/i18n';

  const cards = Array.from(document.querySelectorAll<HTMLElement>('.work-card'));

  // Card click / keyboard → open modal
  cards.forEach(card => {
    card.addEventListener('click', () => openProject(card.dataset.project as string));
    card.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openProject(card.dataset.project as string);
      }
    });
  });

  // Links inside cards must not open the modal
  document.querySelectorAll('.work-card a').forEach(a => {
    a.addEventListener('click', e => e.stopPropagation());
  });

  // "More" toggle for early work
  const moreBtn = document.getElementById('workMore');
  const earlyBlock = document.getElementById('work-early');
  moreBtn?.addEventListener('click', () => {
    if (!earlyBlock) return;
    earlyBlock.hidden = !earlyBlock.hidden;
    moreBtn.setAttribute('aria-expanded', String(!earlyBlock.hidden));
    const key = earlyBlock.hidden ? 'work_more_btn' : 'work_less_btn';
    moreBtn.dataset.i18n = key;
    moreBtn.textContent = i18n[currentLang][key] ?? key;
  });

  // ======= MODALS =======
  let currentLang: Lang = 'en';
  window.addEventListener('langchange', (e: Event) => {
    currentLang = (e as CustomEvent<{lang: Lang}>).detail.lang;
  });

  function openProject(key: string) {
    const p = projectData[key];
    if (!p) return;

    const cardMeta = workCards.find(c => c.id === key);
    document.getElementById('pmEyebrow')!.textContent = 'Project · ' + (cardMeta?.year ?? '');
    document.getElementById('pmTitle')!.innerHTML = p.title[currentLang];
    document.getElementById('pmTags')!.innerHTML  = p.tags.map(t => `<span class="tag">${t}</span>`).join('');

    const links = projectLinks[key];
    const linksEl = document.getElementById('pmLinks')!;
    const t = i18n[currentLang];
    linksEl.innerHTML = [
      links?.github ? `<a class="project-link" href="${links.github}" target="_blank" rel="noopener">${t.work_link_code ?? 'Code ↗'}</a>` : '',
      links?.demo   ? `<a class="project-link" href="${links.demo}" target="_blank" rel="noopener">${t.work_link_live ?? 'Live ↗'}</a>` : '',
    ].join('');

    const galleryEl = document.getElementById('pmGallery')!;
    if (p.images.length) {
      galleryEl.style.display = '';
      galleryEl.innerHTML = p.images.map(src =>
        `<div class="project-image"><img src="${ASSET_BASE}${src}" alt="" loading="lazy" onerror="this.parentElement.innerHTML='<div style=\\'padding:1rem;text-align:center;font-size:0.65rem;color:var(--ink-mute);font-family:var(--mono)\\'>image preview</div>'"></div>`
      ).join('');
    } else {
      galleryEl.style.display = 'none';
    }

    document.getElementById('pmProse')!.innerHTML = p.prose[currentLang];
    openModal('modal-project');
  }

  function openModal(id: string) {
    document.getElementById(id)!.classList.add('open');
    document.body.classList.add('modal-open');
  }
  function closeModal(el: Element) {
    el.classList.remove('open');
    document.body.classList.remove('modal-open');
  }

  document.querySelectorAll('.modal-backdrop').forEach(bd => {
    bd.addEventListener('click', e => { if (e.target === bd) closeModal(bd); });
  });
  document.querySelectorAll('[data-close]').forEach(btn => {
    btn.addEventListener('click', () => closeModal(btn.closest('.modal-backdrop')!));
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') document.querySelectorAll('.modal-backdrop.open').forEach(closeModal);
  });
</script>

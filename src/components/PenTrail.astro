---
// PenTrail — a fixed pen nib on the right edge of the viewport whose height
// mirrors reading progress. While scrolling it bends inward with velocity
// and leaves a fading ink trail on a fixed canvas (comet-style).
// Driven by src/scripts/story/pentrail.ts; hidden without the story gate.
---

<canvas id="pen-canvas" aria-hidden="true"></canvas>
<div id="pen-nib" aria-hidden="true"></div>

<style>
  #pen-canvas,
  #pen-nib {
    display: none;
    position: fixed;
    pointer-events: none;
  }
  html.story #pen-canvas.pen-on,
  html.story #pen-nib.pen-on {
    display: block;
  }
  #pen-canvas {
    inset: 0;
    /* the ink lives IN the paper: behind cards/terminal/text blocks,
       visible only on the empty paper around them */
    z-index: -1;
  }
  #pen-nib {
    top: 0;
    left: 0;
    width: 12px;
    height: 16px;
    background: var(--burgundy);
    /* nib / ink-drop shape, pointing down */
    clip-path: polygon(50% 100%, 4% 38%, 20% 6%, 80% 6%, 96% 38%);
    opacity: 0.85;
    z-index: 50;
    will-change: transform;
    transition: opacity 0.6s ease;
  }
  /* while the reader is reading (no scroll ~1.5s) the pen almost vanishes */
  #pen-nib.pen-resting {
    opacity: 0.22;
  }
</style>

---
// HeroSection — full-viewport hero with animated headline, roles, and card
---

<section class="hero" id="top">
  <div class="hero-stage">
  <div class="hero-meta">
    <span data-i18n="hero_meta_left">Portfolio — MMXXVI</span>
    <span data-i18n="hero_meta_right">Barcelona, ES</span>
  </div>

  <h1 class="hero-headline">
    <span class="line">
      <span class="word" style="animation-delay:.05s">Miguel</span>
      <span class="word italic" style="animation-delay:.16s">Gutiérrez</span>
    </span>
    <span class="line">
      <span class="word" data-i18n="hero_engineer" style="animation-delay:.28s">engineer</span>
      <span class="word ampersand" style="animation-delay:.36s">&amp;</span>
      <span class="word italic" data-i18n="hero_other" style="animation-delay:.46s">other things.</span>
    </span>
  </h1>

  <p class="hero-tagline" data-i18n="hero_tagline">
    <strong>Full-stack Software Engineer &amp; AI Developer</strong> — I build clean-architecture web apps (Vue · Node · TypeScript) and AI-assisted systems for healthcare, in Barcelona.
  </p>

  <div class="hero-stack">
    <div class="hero-roles">
      <span class="line"><span class="num">i.</span><span data-i18n="hero_role_1">I build software alongside AI.</span></span>
      <span class="line"><span class="num">ii.</span><span data-i18n="hero_role_2">I play guitar to forget the bugs.</span></span>
      <span class="line"><span class="num">iii.</span><span data-i18n="hero_role_3">I read philosophy on Sundays.</span></span>
      <span class="line"><span class="num">iv.</span><span data-i18n="hero_role_4">I shoot threes when the knees allow.</span></span>
    </div>

    <div class="hero-card">
      <span data-i18n="hero_card_now">Currently</span>
      <strong data-i18n="hero_card_role">Software Engineer &amp; AI Developer</strong><br>
      <span data-i18n="hero_card_at">at</span>
      <strong>Health Lean Analytics</strong>
      <div class="divider"></div>
      <span data-i18n="hero_card_available">Open to new opportunities</span><br>
      <a class="hero-card-link" href="mailto:mgutierrez@hlanalytics.org"><strong data-i18n="hero_card_cta">Open to talk →</strong></a>
    </div>
  </div>

  <div class="hero-ctas">
    <!-- Re-enable once the CV PDF lands in public/cv/Miguel-Gutierrez-CV.pdf
    <a class="hero-btn primary" href={`${import.meta.env.BASE_URL}cv/Miguel-Gutierrez-CV.pdf`} download data-i18n="hero_cta_cv">Download CV ↓</a>
    -->
  </div>

  <!-- Beat 2 of the pinned hero scene: value phrase with rotating highlighted
       word. Hidden without the story gate (static flow keeps the hero as-is). -->
  <div class="hero-build">
    <p class="hero-build-line">
      <span data-i18n="hero_build_prefix">I build clean-architecture systems for</span>
      <span class="hero-build-words">
        <span class="hb-word is-active" data-i18n="hero_build_w1">healthcare</span>
        <span class="hb-word" data-i18n="hero_build_w2">AI agents</span>
        <span class="hb-word" data-i18n="hero_build_w3">real people</span>
      </span>
    </p>
  </div>
  </div><!-- /hero-stage -->
</section>

<style>
  .hero-stage {
    min-height: 100vh;
    /* vh-aware spacing: the sticky scene locks this stage to exactly 100vh
       (story.css), so everything must fit on short viewports (~800-910px) */
    padding: clamp(6rem, 12vh, 8.75rem) var(--pad) clamp(2.5rem, 6vh, 4rem);
    max-width: var(--max); margin: 0 auto;
    display: grid; gap: clamp(1.25rem, 3vh, 2.5rem); align-content: center;
    position: relative;
  }

  /* Beat 2: value phrase with rotating highlighted word (scene-only) */
  .hero-build {
    display: none; /* shown only under html.story (story.css) */
    position: absolute; inset: 0;
    align-items: center; justify-content: center;
    padding: 0 var(--pad);
    pointer-events: none;
  }
  .hero-build-line {
    font-family: var(--serif); font-weight: 300;
    font-size: clamp(1.8rem, 4.2vw, 3.6rem);
    letter-spacing: -0.02em; line-height: 1.25;
    color: var(--ink); text-align: center;
    max-width: 22ch;
  }
  .hero-build-words {
    position: relative; display: inline-block;
    min-width: 7ch; text-align: left; margin-left: 0.35ch;
  }
  .hb-word {
    position: absolute; left: 0; top: 0;
    white-space: nowrap;
    font-style: italic; font-weight: 400;
    background: var(--paper-3);
    box-shadow: inset 0 -2px 0 var(--burgundy);
    padding: 0 0.18em;
    opacity: 0; transform: translateY(0.35em);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .hb-word.is-active {
    opacity: 1; transform: translateY(0);
    position: relative;
  }

  .hero-meta {
    display: flex; justify-content: space-between;
    font-family: var(--mono); font-size: 0.72rem;
    text-transform: uppercase; letter-spacing: 0.15em;
    color: var(--ink-mute);
    border-top: 1px solid var(--rule); padding-top: 0.85rem;
  }

  .hero-headline {
    font-family: var(--serif); font-weight: 300;
    font-size: clamp(3rem, min(10vw, 16vh), 10rem);
    line-height: 1; letter-spacing: -0.035em; color: var(--ink);
  }
  .hero-headline .italic   { font-style: italic; font-weight: 400; }
  .hero-headline .ampersand { font-style: italic; font-weight: 300; }
  .hero-headline .line     { display: block; }
  .hero-headline .line + .line { margin-top: 0.05em; }

  /* Word-in animation */
  .hero-headline .word {
    display: inline-block;
    opacity: 0; transform: translateY(0.4em);
    animation: wordIn .9s var(--ease) forwards;
  }
  @keyframes wordIn { to { opacity: 1; transform: translateY(0); } }

  .hero-tagline {
    font-family: var(--sans); font-weight: 300;
    font-size: clamp(0.95rem, 1.4vw, 1.15rem);
    color: var(--ink-soft); line-height: 1.7;
    max-width: 58ch; margin-top: 1.1rem;
  }
  .hero-tagline strong { font-weight: 500; color: var(--ink); }

  .hero-stack {
    display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: end;
  }
  @media (min-width: 880px) {
    .hero-stack { grid-template-columns: 1.2fr 1fr; }
  }

  .hero-roles {
    font-family: var(--serif); font-size: clamp(0.95rem, 1.1vw, 1.15rem);
    font-style: italic; font-weight: 300; color: var(--ink-soft);
    line-height: 1.6; max-width: 32ch;
  }
  .hero-roles .num {
    font-family: var(--mono); font-style: normal;
    font-size: 0.7em; color: var(--ink-mute); margin-right: 0.6em;
  }
  .hero-roles .line { display: block; }

  .hero-card {
    font-family: var(--mono); font-size: 0.72rem;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--ink-mute); text-align: right; line-height: 1.9;
  }
  .hero-card strong { color: var(--ink); font-weight: 500; }
  .hero-card .divider {
    width: 32px; height: 1px; background: var(--ink-mute);
    margin: 0.6rem 0 0.6rem auto;
  }
  .hero-card-link { text-decoration: none; }
  .hero-card-link:hover strong { color: var(--burgundy); }
  .hero-card-link strong { transition: color 0.25s var(--ease); }

  .hero-ctas {
    display: flex; flex-wrap: wrap; gap: 0.85rem;
  }
  .hero-btn {
    font-family: var(--mono); font-size: 0.7rem;
    text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--ink); text-decoration: none;
    border: 1px solid var(--ink); border-radius: 100px;
    padding: 0.75rem 1.5rem;
    transition: background 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .hero-btn:hover { background: var(--ink); color: var(--paper); }
  .hero-btn.primary { background: var(--burgundy); border-color: var(--burgundy); color: var(--paper); }
  .hero-btn.primary:hover { background: var(--burgundy-soft); border-color: var(--burgundy-soft); }

  @media (max-width: 560px) {
    .hero-card { text-align: left; }
    .hero-card .divider { margin-left: 0; }
  }
</style>

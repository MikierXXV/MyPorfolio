---
// ContactSection — minimal contact CTA with social links
---

<section class="contact" id="contact">
  <div class="section-head">
    <p class="contact-eyebrow" data-i18n="contact_eyebrow">VI. Let's talk</p>
  </div>

  <div class="contact-body">
    <div class="contact-intro">
      <div class="contact-photo-wrap" data-story="fade-up">
        <img
          class="contact-photo"
          src={`${import.meta.env.BASE_URL}assets/linkedin.png`}
          alt="Miguel Gutiérrez"
          width="180"
          height="180"
          loading="lazy"
        />
        <span class="contact-photo-ring" aria-hidden="true"></span>
      </div>
      <h2 class="contact-headline" data-story="words" data-i18n="contact_headline">
        Got a project<br><em>worth building?</em>
      </h2>
    </div>
    <div class="contact-actions" data-story="fade-up">
      <a class="contact-link" href="mailto:mgutierrez@hlanalytics.org" data-i18n="contact_link">say hello →</a>
      <a class="contact-cv" href={`${import.meta.env.BASE_URL}cv/Miguel-Gutierrez-CV.pdf`} download data-i18n="contact_cv">or download my CV ↓</a>
    </div>
  </div>

  <p class="contact-note" data-story="fade-up" data-i18n="contact_note">Currently Software Engineer &amp; AI Developer at Health Lean Analytics — open to conversations about full-stack and AI engineering roles.</p>

  <div class="contact-socials" data-story="fade-up">
    <a class="social-link" href="https://github.com/MikierXXV" target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-label="GitHub">
        <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
      </svg>
      GitHub
    </a>
    <a class="social-link" href="https://www.linkedin.com/in/miguel-gutjar/" target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-label="LinkedIn">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
      LinkedIn
    </a>
    <a class="social-link" href="mailto:mgutierrez@hlanalytics.org">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="Email">
        <rect x="2" y="4" width="20" height="16" rx="2"/>
        <path d="m2 7 10 8 10-8"/>
      </svg>
      Email
    </a>
  </div>
</section>

<style>
  .contact {
    padding: 6rem var(--pad) 5rem;
    max-width: var(--max); margin: 0 auto;
  }
  .section-head {
    border-top: 1px solid var(--rule); padding-top: 0.85rem;
    margin-bottom: 3rem;
  }
  .contact-eyebrow {
    font-family: var(--mono); font-size: 0.65rem;
    text-transform: uppercase; letter-spacing: 0.15em; color: var(--ink-mute);
  }

  .contact-body {
    display: flex; flex-direction: column; gap: 2.5rem; align-items: flex-start;
    margin-bottom: 4rem;
  }
  @media (min-width: 700px) {
    .contact-body { flex-direction: row; align-items: flex-end; justify-content: space-between; }
  }

  .contact-intro {
    display: flex; align-items: center; gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .contact-photo-wrap {
    position: relative; flex-shrink: 0;
    width: clamp(110px, 14vw, 180px); height: clamp(110px, 14vw, 180px);
  }
  .contact-photo {
    width: 100%; height: 100%;
    border-radius: 50%; object-fit: cover;
    border: 1px solid var(--rule);
  }
  .contact-photo-ring {
    position: absolute; inset: -11px;
    border: 1.5px solid var(--burgundy); border-radius: 50%;
    opacity: 0.55;
  }
  @media (max-width: 560px) {
    .contact-intro { flex-direction: column; align-items: flex-start; }
  }

  .contact-headline {
    font-family: var(--serif); font-weight: 300;
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    letter-spacing: -0.03em; line-height: 1.05; color: var(--ink);
  }
  .contact-headline em { font-style: italic; font-weight: 400; }

  .contact-link {
    font-family: var(--serif); font-style: italic; font-weight: 400;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem); color: var(--ink);
    text-decoration: none; white-space: nowrap;
    border-bottom: 1px solid var(--ink); padding-bottom: 0.1em;
    transition: color .3s, border-color .3s;
    flex-shrink: 0;
  }
  .contact-link:hover { color: var(--burgundy); border-color: var(--burgundy); }

  .contact-actions {
    display: flex; flex-direction: column; gap: 0.85rem;
    align-items: flex-start; flex-shrink: 0;
  }
  @media (min-width: 700px) { .contact-actions { align-items: flex-end; } }
  .contact-cv {
    font-family: var(--mono); font-size: 0.68rem;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--ink-mute); text-decoration: none;
    border-bottom: 1px solid var(--rule); padding-bottom: 0.15em;
    transition: color .3s, border-color .3s;
  }
  .contact-cv:hover { color: var(--burgundy); border-color: var(--burgundy); }

  .contact-note {
    font-family: var(--sans); font-size: 0.82rem;
    color: var(--ink-mute); line-height: 1.7; max-width: 52ch;
    margin: -2.5rem 0 3rem;
  }

  .contact-socials {
    display: flex; gap: 1.5rem; flex-wrap: wrap;
    border-top: 1px solid var(--rule); padding-top: 2rem;
  }
  .social-link {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: var(--mono); font-size: 0.68rem;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--ink-mute); text-decoration: none;
    transition: color .3s;
  }
  .social-link:hover { color: var(--ink); }
</style>

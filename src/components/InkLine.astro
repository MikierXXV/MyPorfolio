---
// InkLine — full-page SVG overlay: a burgundy ink stroke drawn by scroll,
// connecting the chapters, ending in an "MG" signature at Contact.
// Path geometry is computed at runtime by src/scripts/story/inkline.ts.
---

<svg id="ink-line" aria-hidden="true">
  <path id="ink-path" d="" />
  <path id="ink-signature" d="" />
</svg>

<style>
  #ink-line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
    display: none; /* enabled by inkline.ts on capable viewports */
  }
  html.story #ink-line.ink-on {
    display: block;
  }
  #ink-line path {
    fill: none;
    stroke: var(--burgundy);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  #ink-path {
    stroke-width: 1.75;
    opacity: 0.45;
  }
  #ink-signature {
    stroke-width: 2;
    opacity: 0.7;
  }
</style>

---
// PathSection — now only the Licenses & Certifications block (the career
// timeline was fused into CareerScene, chapter III). Cert cards render as
// flippable "cards" (front = content, back = monogram) dealt in threes by
// src/scripts/story/scenes.ts under the story gate.
import { certData } from '../data/timeline';
const certsJSON = JSON.stringify(certData);
---

<section class="path" id="certs">
  <!-- Certifications -->
  <div class="certs-section" id="certs-section">
    <div class="section-head certs-head" data-story-rule>
      <h2 class="section-title" data-story="words" data-i18n="certs_title">Licenses &amp; <em>certifications</em></h2>
    </div>
    <div class="certs-grid" id="certs-grid">
      <!-- populated by JS -->
    </div>
  </div>
</section>

<style is:global>
  .path {
    padding: 6rem var(--pad) 4rem;
    max-width: var(--max); margin: 0 auto;
  }

  .section-head {
    display: flex; justify-content: space-between; align-items: baseline;
    border-top: 1px solid var(--rule); padding-top: 0.85rem; margin-bottom: 3rem;
  }
  .section-title {
    font-family: var(--serif); font-weight: 300;
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.02em; line-height: 1.1; color: var(--ink);
  }
  .section-title em { font-style: italic; font-weight: 400; }
  .section-aside {
    font-family: var(--mono); font-size: 0.68rem;
    text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-mute);
  }
  .section-eyebrow {
    font-family: var(--mono); font-size: 0.62rem;
    text-transform: uppercase; letter-spacing: 0.15em; color: var(--ink-mute);
    margin-bottom: 0.3rem;
  }

  /* ── Certifications ── */
  .certs-head { margin-bottom: 2rem; }
  .certs-head-left { display: flex; flex-direction: column; gap: 0; }

  .certs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    perspective: 1100px;
  }
  @media (min-width: 600px)  { .certs-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .certs-grid { grid-template-columns: repeat(3, 1fr); } }

  .cert-card {
    position: relative;
    min-height: 172px;
    text-decoration: none;
    will-change: transform;
  }
  .cert-inner {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.65s var(--ease);
  }
  .cert-face {
    position: absolute; inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border: 1px solid var(--rule); border-radius: 6px;
    padding: 1.4rem 1.6rem;
    overflow: hidden;
  }
  .cert-front {
    background: var(--paper-2);
    display: flex; flex-direction: column; gap: 0.5rem;
    transition: border-color .3s, box-shadow .3s;
  }
  .cert-back {
    background: var(--paper-3);
    transform: rotateY(180deg);
    display: flex; align-items: center; justify-content: center; gap: 0.9rem;
    border-color: var(--burgundy);
    box-shadow: inset 0 0 0 5px var(--paper-3), inset 0 0 0 6px rgba(122, 31, 43, 0.35);
  }
  .cb-mono {
    font-family: var(--serif); font-style: italic; font-weight: 400;
    font-size: 2.1rem; color: var(--burgundy); opacity: 0.75;
  }
  .cb-star {
    font-size: 1rem; color: var(--ink-mute);
  }

  .cert-card:hover .cert-front { border-color: var(--burgundy); box-shadow: 0 10px 28px rgba(26,22,18,.09); }
  /* sheen sweep on hover */
  .cert-front::after {
    content: ''; position: absolute; top: 0; bottom: 0; width: 45%;
    left: -70%; transform: skewX(-18deg);
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    transition: left .65s var(--ease);
    pointer-events: none;
  }
  .cert-card:hover .cert-front::after { left: 125%; }

  .cert-ext { font-family: var(--mono); font-size: 0.7em; color: var(--burgundy); }
  .cert-year {
    font-family: var(--mono); font-size: 0.6rem;
    text-transform: uppercase; letter-spacing: 0.15em; color: var(--ink-mute);
  }
  .cert-title {
    font-family: var(--serif); font-weight: 300;
    font-size: clamp(0.95rem, 1.4vw, 1.15rem); color: var(--ink); line-height: 1.3;
  }
  .cert-title em { font-style: italic; font-weight: 400; }
  .cert-issuer {
    font-family: var(--mono); font-size: 0.62rem;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-mute);
    line-height: 1.4;
  }
  .cert-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.25rem; }
  .cert-tag {
    font-family: var(--mono); font-size: 0.58rem;
    text-transform: uppercase; letter-spacing: 0.1em;
    padding: 0.2rem 0.5rem; border: 1px solid var(--rule);
    border-radius: 100px; color: var(--ink-mute);
    transition: background 0.25s, color 0.25s, border-color 0.25s;
    cursor: pointer;
  }

  /* ── Pill group focus: hovering/tapping a pill highlights every card
        that shares it and dims the rest ── */
  .cert-card { transition: opacity 0.35s var(--ease); }
  .cert-card.tag-dim { opacity: 0.3; }
  .cert-card.tag-match .cert-front {
    border-color: var(--burgundy);
    box-shadow: 0 10px 28px rgba(26, 22, 18, 0.12);
  }
  .cert-tag.pill-active {
    background: var(--burgundy); color: var(--paper); border-color: var(--burgundy);
  }
</style>

<script define:vars={{ certsJSON }}>
  const certData = JSON.parse(certsJSON);

  let currentLang = 'en';
  const certsGrid = document.getElementById('certs-grid');

  function renderCerts() {
    if (!certsGrid) return;
    const certs = certData[currentLang] ?? certData['en'];
    const norm = (t) => t.toLowerCase().replace(/\s+/g, '-');
    certsGrid.innerHTML = certs.map(c => {
      const linked = c.url && c.url !== '#';
      const front = `
        <div class="cert-face cert-front">
          <span class="cert-year">${c.year}</span>
          <h3 class="cert-title">${c.title}${linked ? ' <span class="cert-ext">↗</span>' : ''}</h3>
          <p class="cert-issuer">${c.issuer}</p>
          <div class="cert-tags">${c.tags.map(t => `<span class="cert-tag" data-tag="${norm(t)}">${t}</span>`).join('')}</div>
        </div>
      `;
      const back = `
        <div class="cert-face cert-back"><span class="cb-star">✳</span><span class="cb-mono">MG</span><span class="cb-star">✳</span></div>
      `;
      const inner = `<div class="cert-inner">${front}${back}</div>`;
      const tagsAttr = c.tags.map(norm).join('|');
      return linked
        ? `<a class="cert-card" data-tags="${tagsAttr}" href="${c.url}" target="_blank" rel="noopener">${inner}</a>`
        : `<div class="cert-card" data-tags="${tagsAttr}">${inner}</div>`;
    }).join('');
  }

  renderCerts();

  window.addEventListener('langchange', (e) => {
    currentLang = e.detail.lang;
    renderCerts();
  });
</script>

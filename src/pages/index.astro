---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
import HeroSection from '../components/HeroSection.astro';
import WorkSection from '../components/WorkSection.astro';
import OffKeyboardSection from '../components/OffKeyboardSection.astro';
import PathSection from '../components/PathSection.astro';
import StackSection from '../components/StackSection.astro';
import ToolsSection from '../components/ToolsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Miguel Gutiérrez · Portfolio">
  <NavBar />
  <HeroSection />
  <WorkSection />
  <OffKeyboardSection />
  <PathSection />
  <StackSection />
  <ToolsSection />
  <ContactSection />
  <Footer />
</BaseLayout>

<script>
  /* ── Touch-device text adaptations ──
     On hover-incapable devices (phones/tablets) replace all "hover" hints
     with "tap" equivalents. Re-runs on lang change so translations stay correct. */
  const touchCopy: Record<string, Record<string, string>> = {
    path_aside:  { en: 'Tap the dots · current role shown', es: 'Toca los puntos · rol actual visible', ca: 'Toca els punts · rol actual visible' },
    stack_aside: { en: 'Tap · drag · explore',            es: 'Toca · arrastra · explora',          ca: 'Toca · arrossega · explora' },
    graph_hint:  { en: 'Tap a node to see its links',     es: 'Toca un nodo para ver sus conexiones', ca: 'Toca un node per veure les connexions' },
  };

  function adaptForTouch(lang: string = 'en') {
    if (!window.matchMedia('(hover: none)').matches) return;
    Object.entries(touchCopy).forEach(([key, texts]) => {
      document.querySelectorAll<HTMLElement>(`[data-i18n="${key}"]`).forEach(el => {
        el.textContent = texts[lang] ?? texts['en'];
      });
    });
  }

  adaptForTouch();
  window.addEventListener('langchange', (e) => {
    adaptForTouch((e as CustomEvent<{ lang: string }>).detail.lang);
  });
</script>
